# SMTP credentials for the contact form. Keep real values in .env.local only.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=replace-me
CONTACT_FROM="Labish Bardiya <hello@labishbardiya.com>"
CONTACT_TO=your-inbox@example.com

# Supabase public values. These are safe to expose in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
